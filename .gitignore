# Dependencies
node_modules

# Build outputs
dist
dist-ssr

# Local env files
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Android build artifacts
app-debug.apk
app-release.apk
*.apk
*.aab

# Android Gradle cache (local build state, not needed in repo)
android/.gradle/
android/app/build/
android/build/
android/capacitor-cordova-android-plugins/

# Android Studio workspace/caches (machine-specific)
android/.idea/workspace.xml
android/.idea/caches/
android/.idea/gradle.xml
android/.idea/navEditor.xml

# Capacitor generated assets (rebuilt by `npx cap sync`)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml

# iOS build artifacts / caches（ios/.gitignore 已覆盖同款，这里是根级双保险：
# 那份文件一旦被误删，`git add ios/` 会把 build/Pods/本机绝对路径整包带上远端）
ios/App/build/
ios/App/Pods/
ios/App/output/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App/config.xml
ios/DerivedData/
ios/capacitor-cordova-ios-plugins/
xcuserdata/

# Scripts compiled output
scripts/*.class

# Misc local files
*.log

# 音频素材不入库（体积/授权考量）。public/ 下的 UI 反馈音需自备，
# 文件名见 src/utils/feedback.ts 与各处 playSound() 调用；缺失时音效静默。
*.mp3
# 例外：UI 反馈音（26 个小文件，共约 200KB）随仓库走——它们必须进 public/
# 才能被 Vite 打进 dist，否则线上静默无声（见 HANDOFF §二十六）。
!public/*.mp3
*.wav

# 本地 Agent 工具目录
.claude/

# 塔罗原稿（118 MB PNG）：只提交 public/tarot 下压缩后的 webp，原稿留在本地
/tarot/

# 部署配置不入库：域名 / 证书路径 / root 全是特定机器的，且极易与线上脱节。
# （旧版曾在仓库里躺了几个月、和线上没有一处对得上，排查时反而把人带偏。）
# 线上那份以部署机上的站点配置为准（证书由 ACME 客户端自动续期）。
nginx.conf

# 文档不入库（用户规则 2026-08-31）：除 README.md 外的 .md 一律不推
# —— 2026-10-12 起改为私有开发仓库：策划书纳入版本管理；展示仓库（Persona-Terminal）仍沿用旧规则
*.md
!README.md
!策划书*.md
!PROJECT_STATE.md
# 合规提醒：必须入库存档（署名/素材/使用边界），否则接手者看不到、易误删署名
!COMPLIANCE.md

# ===== backend（Java/Maven）=====
backend/target/
backend/.idea/
backend/*.iml

# 本机测试台（无头浏览器脚本、假 PB、本机 PocketBase 实例）：只放本地，不上 GitHub
tests-local/

# ===== monorepo 本地目录（不上 GitHub）=====
# the-velvet/：合并前的旧前端目录（内容已铺在根目录，且自留 .git）——保留本地作备用
the-velvet/
# 参考资料/截图/落选图标
refs/
反面案例/
icon-candidates/
# Rivet 工作区元数据
.rivet/

# ===== 本项目追加（2026-06）：公开仓库版权隔离 =====
# 塔罗牌面 webp（public/tarot/ 三频道各 22 张）：来源上游美术，保守不入公开仓库
public/tarot/

# 毕设策划书：私有开发仓库中纳入版本管理（上面 !策划书*.md 已反向豁免）
# 展示仓库如需隔离，用其自身的 .gitignore 规则

# ===== 上传文件（头像等，不入库）=====
backend/uploads/

# ===== 凭据防护（2026-10-13）=====
# start.bat 曾误含明文邮箱授权码并入库，已移除。今后凭据只走环境变量，不进任何入库文件。
# 若本机需要放凭据，用下面这些（均不入库）：
.env.local
.env.*.local
*.local.bat
start.local.bat

# 设计工具的工作目录（方向稿、检查器报告、参考图，不入库）
.taste-skill/

# ===== 对标研究素材（2026-10-14）=====
# outputs/_recon/ 里是从参考站抓下来的源码副本与截图，只作本地拆解用，
# 属于第三方内容，不进仓库（site/ 里没有任何参考站的代码或素材）。
outputs/_recon/

# ===== 安装包（2026-10-14）=====
# 官网的下载按钮指向 site/download/ 里的 APK。25 MB 的二进制不进 git，
# 换新版本时把新包覆盖进来即可（仓库只跟源码走）。
site/download/*.apk

# 主题对比截图输出
.theme-compare/

