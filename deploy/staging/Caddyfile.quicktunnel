http://:8082 {
	encode gzip zstd

	@insecure header X-Forwarded-Proto http
	redir @insecure https://{host}{uri} 308

	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8080
	}

	@index path / /index.html
	header @index Cache-Control "no-cache, must-revalidate"

	@serviceWorker path /sw.js
	header @serviceWorker Cache-Control "no-cache"

	header {
		-Server
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	root * /opt/maskaria-staging/web
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}

	log {
		output file /var/log/caddy/maskaria-staging-access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
