+/* Four-theme interaction contract. Geometry, colors and battle rules stay in their theme. */
+/* Important declarations in this layer intentionally outrank the imported skins' legacy !important rules. */
+@layer ui-interaction {
+  :root { --ui-motion: 220ms; --ui-ease: cubic-bezier(.22,.61,.36,1); }
+  @media (prefers-reduced-motion: no-preference) {
+    :is(button, a[data-room], [role=button], .night-base-card, .night-npcs>article),
+    :is(button, a[data-room])::before,
+    :is(button, a[data-room])::after,
+    :is(button, a[data-room])>svg {
+      transition-property: transform, translate, rotate, scale, opacity, color, background-color, border-color, box-shadow, outline-color !important;
+      transition-duration: var(--ui-motion) !important;
+      transition-timing-function: var(--ui-ease) !important;
+      transition-delay: 0s !important;
+    }
+    /* Press and release both interpolate; keep each skin's positional transform intact. */
+    button:not(:disabled):active {
+      scale: .96 !important;
+      transition-duration: 80ms !important;
+    }
+  }
+  /* The inherited command-settle keyframe fights hover/selection and moves rebuilt buttons. */
+  .command-grid>button[aria-pressed=true] { animation-name: none !important; }
+  .command-grid>button { rotate: none !important; }
+  /* Input is ready when the conversation opens; do not hide it behind the bubble's 900ms delay. */
+  html[data-skin=hamuko] .slice-talk-box textarea {
+    animation: none !important;
+    opacity: 1 !important;
+  }
+  /* Keep money on one line inside the existing receipt; a wrapped final digit changes its meaning. */
+  html[data-theme=p4] .night-base-stats>div:first-child b {
+    white-space: nowrap !important;
+    overflow-wrap: normal !important;
+    flex-shrink: 0;
+  }
+  :is(.night-base-stats,.enemy-hp,.player-hud,.map-hud) {
+    font-variant-numeric: tabular-nums;
+  }
+  /* Long sheets need their own scroll area; keep the authored header and close control reachable. */
+  @media (max-width: 820px), (max-height: 700px) {
+    dialog#sheet[open] {
+      display: flex !important;
+      flex-direction: column;
+      overflow: hidden !important;
+    }
+    #sheet>.sheet-top { flex: 0 0 auto; }
+    #sheet>#sheet-body {
+      min-height: 0;
+      overflow-y: auto !important;
+      overscroll-behavior: contain;
+      scroll-padding-block: 16px;
+    }
+  }
+  html[data-theme=p3]:not([data-skin=hamuko]) .command-grid>button:hover:not(:disabled) {
+    translate: none !important;
+  }
+  /* A selection must not change the ribbon's width/height or move it 18–24px into its neighbor. */
+  html[data-skin=hamuko] .command-grid>button[aria-pressed=true] {
+    translate: 0 0 !important;
+    width: 280px !important;
+    height: 62px !important;
+  }
+  html[data-skin=hamuko] body.sh-m .command-grid>button[aria-pressed=true] {
+    width: 172px !important;
+    height: 34px !important;
+  }
+  /* Keyboard focus remains distinct from hover without changing the button's size. */
+  :is(button,a[data-room],[role=button]):focus-visible {
+    outline: 2px solid currentColor !important;
+    outline-offset: 4px !important;
+  }
+  :is(button,a[data-room],input,textarea,select) {
+    scroll-margin-block-start: 24px;
+    scroll-margin-block-end: calc(88px + env(safe-area-inset-bottom, 0px));
+  }
+  @media (prefers-reduced-motion: reduce) {
+    :is(button,a[data-room],[role=button]),
+    :is(button,a[data-room])::before,
+    :is(button,a[data-room])::after,
+    :is(button,a[data-room])>svg {
+      transition: none !important;
+    }
+  }
+}
