{
 "id": "env.date.flip",
 "event": "env:change",
 "duration": 600,
 "assets": [
  "hud.datePlate"
 ],
 "tracks": [
  {
   "at": 0,
   "dur": 600,
   "prim": "dim",
   "args": {
    "color": "#000",
    "alpha": 0.3
   }
  },
  {
   "at": 0,
   "dur": 580,
   "prim": "dateFlip",
   "layer": "hud",
   "ease": "inOutCubic",
   "args": {
    "from": "$prev",
    "to": "$env",
    "pages": 2,
    "plate": "hud.datePlate",
    "weatherIcons": "hud.weather.",
    "font": "@font.number"
   },
   "minimal": {
    "dur": 250,
    "args": {
     "from": "$prev",
     "to": "$env",
     "pages": 1
    }
   }
  },
  {
   "at": 0,
   "prim": "sfx",
   "args": {
    "id": "date.flip"
   }
  }
 ]
}